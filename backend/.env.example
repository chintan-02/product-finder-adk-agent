# Obtain a Gemini API key from Google AI Studio. Never commit the real value.
GOOGLE_API_KEY=your_google_api_key

# Current stable Flash model; override without modifying source code.
PRODUCT_AGENT_MODEL=gemini-3.6-flash
ADK_APP_NAME=product_finder

# Comma-separated exact frontend origins. Do not use * in production.
ALLOWED_ORIGINS=http://localhost:5173
